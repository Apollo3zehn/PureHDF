HDF5 "<file-path>" {
GROUP "/" {
   <type> "String[,,]" {
      DATATYPE  H5T_STRING {
         STRSIZE 2;
         STRPAD H5T_STR_NULLPAD;
         CSET H5T_CSET_UTF8;
         CTYPE H5T_C_S1;
      }
      DATASPACE  SIMPLE { ( 3, 3, 3 ) / ( 3, 3, 3 ) }
      DATA {
      (0,0,0): "A\000", "B\000", "C\000",
      (0,1,0): "D\000", "E\000", "F\000",
      (0,2,0): "G\000", "H\000", "I\000",
      (1,0,0): "J\000", "K\000", "L\000",
      (1,1,0): "M\000", "N\000", "O\000",
      (1,2,0): "P\000", "Q\000", "R\000",
      (2,0,0): "S\000", "T\000", "U\000",
      (2,1,0): "V\000", "W\000", "X\000",
      (2,2,0): "Y\000", "Z\000", "\37777777703\37777777604"
      }
   }
}
}