HDF5 "<file-path>" {
GROUP "/" {
   <type> "Memory`1" {
      DATATYPE  H5T_STRING {
         STRSIZE 4;
         STRPAD H5T_STR_NULLPAD;
         CSET H5T_CSET_UTF8;
         CTYPE H5T_C_S1;
      }
      DATASPACE  SIMPLE { ( 3 ) / ( 3 ) }
      DATA {
      (0): "A\000\000\000", "\37777777703\37777777637AB", "C BA"
      }
   }
}
}